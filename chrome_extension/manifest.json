{
  "manifest_version": 3,
  "name": "Booth Import Manager",
  "version": "0.3.0",
  "description": "BOOTH 라이브러리에서 바로 Unity로 임포트하고, 받은 파일과 찜목록을 관리합니다.",
  "permissions": ["downloads", "storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://booth.pm/*",
    "https://*.booth.pm/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Booth Import Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://accounts.booth.pm/library*"],
      "js": ["content/shared.js", "content/library.js"],
      "css": ["content/bim.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://booth.pm/*/items/*", "https://booth.pm/items/*", "https://*.booth.pm/items/*"],
      "exclude_matches": ["https://accounts.booth.pm/*"],
      "js": ["content/shared.js", "content/item.js"],
      "css": ["content/bim.css"],
      "run_at": "document_idle"
    }
  ]
}
